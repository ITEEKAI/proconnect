{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-sqlite --experimental-strip-types --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --experimental-sqlite --experimental-strip-types --test src/test/*.test.ts",
    "seed": "node --experimental-sqlite --experimental-strip-types src/db/seed.ts",
    "start": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "4.21.2",
    "stripe": "^18.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "typescript": "5.9.3"
  }
}
